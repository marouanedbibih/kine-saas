classDiagram

%% ENUMS
class UserRole {
  <<enumeration>>
  ADMIN
  THERAPIST
}

class Gender {
  <<enumeration>>
  MALE
  FEMALE
  OTHER
}

%% USER
class User {
  +UUID id
  +String email
  +String password
  +UserRole role
  +authenticate(password: String): boolean
  +hasRole(role: UserRole): boolean
}

%% ADMIN
class Admin {
  +UUID id
  +String fullName
  +UUID userId
  +generateCabinetReport(cabinetId: UUID): Report
  +manageTherapistAccess(therapistId: UUID, enabled: boolean): void
}
User <|-- Admin

%% THERAPIST
class Therapist {
  +UUID id
  +String firstName
  +String lastName
  +String phone
  +UUID userId
  +UUID cabinetId
  +assignPatient(patientId: UUID): void
  +createSession(patientId: UUID, date: Date): Session
  +uploadMedicalDocument(patientId: UUID, fileUrl: String): MedicalDocument
}
User <|-- Therapist

%% PATIENT
class Patient {
  +UUID id
  +String firstName
  +String middleName
  +String lastName
  +Date dateOfBirth
  +Gender gender
  +String address
  +String city
  +String state
  +String zipCode
  +String phone
  +String altPhone
  +String email
  +String emergencyContactName
  +String emergencyContactPhone
  +String emergencyContactEmail
  +String emergencyContactRelation
  +String profilePhotoUrl
  +UUID cabinetId
  +getMedicalHistory(): MedicalDocument[]
  +getUpcomingSessions(): Session[]
}

%% CABINET
class Cabinet {
  +UUID id
  +String name
  +String address
  +String city
  +String phone
  +getPatientList(): Patient[]
  +getTherapistSchedule(therapistId: UUID): Session[]
}

%% SESSION
class Session {
  +UUID id
  +Date date
  +String notes
  +int duration
  +UUID patientId
  +UUID therapistId
  +reschedule(newDate: Date): void
  +addNote(note: String): void
}

%% MEDICAL DOCUMENT
class MedicalDocument {
  +UUID id
  +String title
  +String description
  +String fileUrl
  +Date uploadedAt
  +UUID patientId
  +UUID uploadedById
  +isConfidential(): boolean
  +shareWith(email: String): void
}

%% RELATIONS
Cabinet "1" --> "0..*" Patient : hosts
Cabinet "1" --> "0..*" Therapist : employs

Patient "1" --> "0..*" Session : attends
Therapist "1" --> "0..*" Session : conducts

Patient "1" --> "0..*" MedicalDocument : owns
Therapist "1" --> "0..*" MedicalDocument : uploads
